{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "predev": "npm run sync:maplibre",
    "prebuild": "npm run sync:maplibre",
    "sync:maplibre": "node -e \"const fs=require('fs');fs.mkdirSync('public/maplibre',{recursive:true});for(const f of['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync('node_modules/maplibre-gl/dist/'+f,'public/maplibre/'+f)\"",
    "seed:crm": "tsx --env-file=../backend/.env scripts/seed-crm.ts",
    "seed:demo": "tsx --env-file=../backend/.env scripts/seed-demo.ts",
    "seed:restaurant": "tsx --env-file=../backend/.env scripts/seed-restaurant.ts",
    "setup:stripe": "tsx --env-file=../backend/.env scripts/setup-stripe.ts",
    "setup:stripe:live": "tsx --env-file=../backend/.env scripts/setup-stripe.ts --live",
    "legal:check": "tsx --env-file=../backend/.env scripts/publish-legal.ts --check",
    "legal:publish": "tsx --env-file=../backend/.env scripts/publish-legal.ts",
    "seed:shop": "tsx --env-file=../backend/.env scripts/seed-shop.ts",
    "shop:owner": "tsx --env-file=../backend/.env scripts/shop-owner.ts",
    "agents:activate": "tsx --env-file=../backend/.env scripts/agents-activate.ts",
    "db:login": "supabase --workdir .. login",
    "db:link": "supabase --workdir .. link",
    "db:push": "supabase --workdir .. db push",
    "db:diff": "supabase --workdir .. db diff",
    "db:types": "supabase --workdir .. gen types typescript --linked > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "maplibre-gl": "^6.3.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
