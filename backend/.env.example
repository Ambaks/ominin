ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude auth — one of the two. The OAuth token (run `claude setup-token`
# on your machine, valid one year) bills your Claude Code subscription and
# is the intended mode; an API key (console.anthropic.com) bills
# pay-per-use. Locally, with neither set, your `claude` login is used.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- Outreach agent (« Léa ») ---

# Shared secret for /agent/* triggers — openssl rand -hex 32.
# Same value goes in the GitHub Actions secret AGENT_TRIGGER_SECRET.
AGENT_TRIGGER_SECRET=

# Google Cloud → Places API (New) → restricted API key
GOOGLE_PLACES_API_KEY=

# Google Cloud → Gmail API → OAuth desktop client (app in "production"
# publishing status). Refresh token from: uv run python scripts/gmail_auth.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# HMAC secret for unsubscribe links — openssl rand -hex 32.
# The same value must be set in Vercel as OUTREACH_UNSUBSCRIBE_SECRET.
OUTREACH_UNSUBSCRIBE_SECRET=

# Testing safety valve: when set, every outbound email is redirected here.
OUTREACH_REDIRECT_TO=

# Optional overrides (defaults in app/config.py):
# OUTREACH_CITIES=Montpellier,Toulouse
# OUTREACH_MODEL=claude-fable-5
# OUTREACH_DAILY_LIMIT=25
# OUTREACH_UNSUBSCRIBE_BASE_URL=https://ominin.com/api/desinscription
